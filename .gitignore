# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment files
.env
.env.local
.env.*.local

# Node (in case of future tooling)
node_modules/
npm-debug.log*

# Python (in case of future tooling)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# NOTE: dist/ is NOT ignored — it holds the generated single-file builds
# (dist/kaogong-*.md) that non-filesystem platforms install from, and CI
# verifies they stay in sync with skills/.

# Logs
*.log

# Temporary files
tmp/
temp/
